VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional live service endpoints. Fran CRM defaults to mocked responses until set.
VITE_FRAN_CRM_URL=
VITE_SKUMS_API_URL=
VITE_SKUMS_API_KEY=

# Direct Postgres connection string for migrations.
# Prefer the Supabase pooler URL when direct db.<project-ref>.supabase.co DNS is unavailable.
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres
# SUPABASE_DB_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-1-your-region.pooler.supabase.com:6543/postgres

SUPABASE_DB_PASSWORD=your-db-password
# If SUPABASE_DB_URL is absent, the migration runner can derive a direct URL
# from VITE_SUPABASE_URL + SUPABASE_DB_PASSWORD.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe Terminal (S700 + Android Tap to Pay). Secret stays on the server only.
# Use sk_test_… for Stripe acceptance. Set these on Vercel for production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional when the dashboard is not on the same origin as /api
# VITE_STRIPE_API_BASE=

# Fran HRM (POS auth P0 — register unlock)
VITE_FRAN_HRM_URL=https://fran-hrm.vercel.app
# Server-only (Vercel): API key with pos:verify or pos:sync
FRAN_HRM_URL=https://fran-hrm.vercel.app
FRAN_HRM_API_KEY=
